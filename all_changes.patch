+                            label: qsTr("Performance"),
+                            propertyName: "showPerformance",
+                            onToggled: function (checked) {
+                                root.showPerformance = checked;
+                                root.saveConfig();
+                            }
+                        },
+                        {
+                            label: qsTr("Weather"),
+                            propertyName: "showWeather",
+                            onToggled: function (checked) {
+                                root.showWeather = checked;
+                                root.saveConfig();
+                            }
+                        }
+                    ]
+                }
+            }
+        }
+    }
+
+    Component {
+        id: performanceComponent
+
+        SectionPage {
