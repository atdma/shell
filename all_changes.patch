+                alignTop: true
+
+                ConnectedButtonGroup {
+                    rootItem: root
+                    rows: 2
+                    options: [
+                        {
+                            label: qsTr("Dashboard"),
+                            propertyName: "showDashboard",
+                            onToggled: function (checked) {
+                                root.showDashboard = checked;
+                                root.saveConfig();
+                            }
+                        },
+                        {
+                            label: qsTr("Media"),
+                            propertyName: "showMedia",
+                            onToggled: function (checked) {
+                                root.showMedia = checked;
