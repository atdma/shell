+        id: content
+
+        screen: root.screen
+        offsetScale: root.offsetScale
+
+        anchors.verticalCenter: parent.verticalCenter
+        anchors.left: parent.left
+        anchors.leftMargin: (-implicitWidth - 5) * root.offsetScale
+    }
