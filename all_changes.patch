+void LazyListView::setModel(QAbstractItemModel* model) {
+    if (m_model == model)
+        return;
+
+    if (m_model)
+        disconnectModel();
+
+    m_model = model;
+
+    if (m_model)
+        connectModel();
+
+    resetContent();
+    emit modelChanged();
+}
