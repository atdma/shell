+bool LazyListView::isDelegateReady(QQuickItem* item) {
+    if (!item)
+        return false;
+    auto* att = qobject_cast<LazyListViewAttached*>(qmlAttachedPropertiesObject<LazyListView>(item, false));
+    return !att || att->ready();
+}
